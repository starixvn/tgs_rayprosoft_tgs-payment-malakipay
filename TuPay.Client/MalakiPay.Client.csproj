		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Tgs.Payment.MalakiPay</RootNamespace>
		<LangVersion>10</LangVersion>
		<PackageId>Tgs.Payment.MalakiPay.Client</PackageId>
		<Version>0.0.5</Version>
		<Authors>Raypro</Authors>
		<Product>Tgs.Payment.MalakiPay.Client</Product>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-payment-tupay</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-payment-tupay.git</RepositoryUrl>
